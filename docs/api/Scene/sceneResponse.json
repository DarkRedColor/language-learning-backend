angly.ai\/api\/bg\/production\/julia_home_rose_room_day_S","characters":{"id":5,"position":0,"active":null,"emotion_id":53}},{"id":1753,"nextId":"1754","text":"See you later, mom!","background":"https:\/\/m3d14.langly.ai\/api\/bg\/production\/julia_home_rose_room_day_S","characters":{"id":5,"position":0,"active":null,"emotion_id":50}},{"id":1747,"nextId":"1748","text":"But the lessons are great, seriously! And we complete them without any errors.","background":"https:\/\/m3d14.langly.ai\/api\/bg\/production\/julia_home_rose_room_day_S","characters":{"id":5,"position":0,"active":null,"emotion_id":52}},{"id":1748,"nextId":"1749","text":"Why do you seem to be lost in thoughts then?","background":"https:\/\/m3d14.langly.ai\/api\/bg\/production\/julia_home_rose_room_day_S","characters":{"id":2,"position":1,"active":null,"emotion_id":28}},{"id":1749,"nextId":"1750","text":"Nothing, I'm just thinking maybe he needs a repair.","background":"https:\/\/m3d14.langly.ai\/api\/bg\/production\/julia_home_rose_room_day_S","characters":{"id":5,"position":0,"active":null,"emotion_id":53}},{"id":1721,"nextId":"1722","text":"Good day to you, Julia!","background":"https:\/\/m3d14.langly.ai\/api\/bg\/production\/julia_home_rose_room_day_S","characters":{"id":2,"position":1,"active":null,"emotion_id":16}},{"id":1736,"nextId":"1737","text":"Oh, wow.","background":"https:\/\/m3d14.langly.ai\/api\/bg\/production\/julia_home_rose_room_day_S","characters":{"id":5,"position":0,"active":null,"emotion_id":53}},{"id":1737,"nextId":"1738","text":"Are you OK? I see that you don't listen to me at all.","background":"https:\/\/m3d14.langly.ai\/api\/bg\/production\/julia_home_rose_room_day_S","characters":{"id":2,"position":1,"active":null,"emotion_id":28}},{"id":1712,"nextId":"1713","text":"Did you like it?","background":"https:\/\/m3d14.langly.ai\/api\/bg\/production\/julia_home_rose_room_day_S","characters":{"id":5,"position":0,"active":null,"emotion_id":50}},{"id":1713,"nextId":null,"text":"Yes, a lot! I learned it at my university. And in the school a little.","background":"https:\/\/m3d14.langly.ai\/api\/bg\/production\/julia_home_rose_room_day_S","characters":{"id":2,"position":1,"active":null,"emotion_id":17}},{"id":1719,"nextId":"1720","text":"Let's start with the greetings then.","background":"https:\/\/m3d14.langly.ai\/api\/bg\/production\/julia_home_rose_room_day_S","characters":{"id":5,"position":0,"active":null,"emotion_id":50}},{"id":1720,"nextId":"1721","text":"OK!","background":"https:\/\/m3d14.langly.ai\/api\/bg\/production\/julia_home_rose_room_day_S","characters":{"id":2,"position":1,"active":null,"emotion_id":16}},{"id":1741,"nextId":"1742","text":"I'm fine. Everything's fine, really.","background":"https:\/\/m3d14.langly.ai\/api\/bg\/production\/julia_home_rose_room_day_S","characters":{"id":5,"position":0,"active":null,"emotion_id":50}},{"id":1752,"nextId":"1753","text":"And thank you so much for practicing English with me!","background":"https:\/\/m3d14.langly.ai\/api\/bg\/production\/julia_home_rose_room_day_S","characters":{"id":5,"position":0,"active":null,"emotion_id":52}},{"id":1706,"nextId":"1707","text":"Yes, dear?","background":"https:\/\/m3d14.langly.ai\/api\/bg\/production\/julia_home_rose_room_day_S","characters":{"id":2,"position":1,"active":null,"emotion_id":16}},{"id":1722,"nextId":"1723","text":"Hello, mom! Can you tell me, what is your...","background":"https:\/\/m3d14.langly.ai\/api\/bg\/production\/julia_home_rose_room_day_S","characters":{"id":5,"position":0,"active":null,"emotion_id":51}},{"id":1702,"nextId":"1703","text":"I'm fine, thanks. How are you?","background":"https:\/\/m3d14.langly.ai\/api\/bg\/production\/julia_home_rose_room_day_S","characters":{"id":5,"position":0,"active":null,"emotion_id":53}},{"id":1703,"nextId":"1704","text":"All good. How are your lessons going?","background":"https:\/\/m3d14.langly.ai\/api\/bg\/production\/julia_home_rose_room_day_S","characters":{"id":2,"position":1,"active":null,"emotion_id":16}},{"id":1717,"nextId":"1718","text":"And had the chance to speak a lot in English.","background":"https:\/\/m3d14.langly.ai\/api\/bg\/production\/julia_home_rose_room_day_S","characters":{"id":2,"position":1,"active":null,"emotion_id":27}},{"id":1728,"nextId":"1729","text":"When I was at the university, I dreamed of a career as a chemist.","background":"https:\/\/m3d14.langly.ai\/api\/bg\/production\/julia_home_rose_room_day_S","characters":{"id":2,"position":1,"active":null,"emotion_id":16}},{"id":1744,"nextId":"1745","text":"Actually, there is something I want to tell you.","background":"https:\/\/m3d14.langly.ai\/api\/bg\/production\/julia_home_rose_room_day_S","characters":{"id":5,"position":0,"active":null,"emotion_id":53}},{"id":1750,"nextId":"1751","text":"I've always told you to be careful with technologies, dear. Please, take care. And contact the experts if necessary.","background":"https:\/\/m3d14.langly.ai\/api\/bg\/production\/julia_home_rose_room_day_S","characters":{"id":2,"position":1,"active":null,"emotion_id":28}},{"id":1751,"nextId":null,"text":"OK, I understood.","background":"https:\/\/m3d14.langly.ai\/api\/bg\/production\/julia_home_rose_room_day_S","characters":{"id":5,"position":0,"active":null,"emotion_id":50}},{"id":1754,"nextId":null,"text":"See you, dear. Remember, take care of yourself!","background":"https:\/\/m3d14.langly.ai\/api\/bg\/production\/julia_home_rose_room_day_S","characters":{"id":2,"position":1,"active":null,"emotion_id":28}},{"id":1701,"nextId":"1702","text":"I rarely see you since you have started English lessons.","background":"https:\/\/m3d14.langly.ai\/api\/bg\/production\/julia_home_rose_room_day_S","characters":{"id":2,"position":1,"active":null,"emotion_id":28}},{"id":1704,"nextId":"1705","text":"Oh, they're great!","background":"https:\/\/m3d14.langly.ai\/api\/bg\/production\/julia_home_rose_room_day_S","characters":{"id":5,"position":0,"active":null,"emotion_id":51}},{"id":1705,"nextId":"1706","text":"Actually, I wanted to ask you about something.","background":"https:\/\/m3d14.langly.ai\/api\/bg\/production\/julia_home_rose_room_day_S","characters":{"id":5,"position":0,"active":null,"emotion_id":53}},{"id":1707,"nextId":"1708","text":"Can you speak to me in English a little, please?","background":"https:\/\/m3d14.langly.ai\/api\/bg\/production\/julia_home_rose_room_day_S","characters":{"id":5,"position":0,"active":null,"emotion_id":53}},{"id":1708,"nextId":"1709","text":"Sure, Julia! It will be strange for me, but I will try. I studied English a long time ago.","background":"https:\/\/m3d14.langly.ai\/api\/bg\/production\/julia_home_rose_room_day_S","characters":{"id":2,"position":1,"active":null,"emotion_id":16}},{"id":1714,"nextId":"1715","text":"When was it?","background":"https:\/\/m3d14.langly.ai\/api\/bg\/production\/julia_home_rose_room_day_S","characters":{"id":5,"position":0,"active":null,"emotion_id":50}}],"choice_frame_data":[{"id":1709,"background":"https:\/\/m3d14.langly.ai\/api\/bg\/production\/julia_home_rose_room_day_S","characters":{"id":5,"position":0,"active":null,"emotion_id":50},"choices":[{"next_id":"1712","text":"Did you like it?"},{"next_id":"1714","text":"When was it?"}]},{"id":1723,"background":"https:\/\/m3d14.langly.ai\/api\/bg\/production\/julia_home_rose_room_day_S","characters":{"id":5,"position":0,"active":null,"emotion_id":50},"choices":[{"next_id":"1726","text":"...dream job?"},{"next_id":"1731","text":"...your job right now?"}]},{"id":1738,"background":"https:\/\/m3d14.langly.ai\/api\/bg\/production\/julia_home_rose_room_day_S","characters":{"id":5,"position":0,"active":null,"emotion_id":53},"choices":[{"next_id":"1741","text":"I'm fine."},{"next_id":"1744","text":"Actually, there is something..."}]}]}}