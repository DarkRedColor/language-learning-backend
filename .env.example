APP_NAME=LanguageLearning
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_VERSION=1.1
FORCE_SSL=false

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=language_learning
DB_USERNAME=
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=4800

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Public API consumed by the mobile app / media service
API_URL=http://localhost/api/
# Deployment slot used to choose the media storage folder (e.g. uploads / production)
SLOT=uploads

# Search (Laravel Scout + TNTSearch)
SCOUT_DRIVER=tntsearch
TNTSEARCH_FUZZINESS=auto

# JWT auth
JWT_SECRET=

# Google OAuth sign-in for the admin panel
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_SECRET_KEY=

# Google Cloud Storage for static media
GCP_PROJECT_ID=
GCS_BUCKET=
GCS_API_URI=

# SFTP access to the media storage server
SFTP_HOST=
SFTP_USER=
SFTP_PASSWORD=
SFTP_PATH=/mnt/storage/uploads/file

# Oxford Learner's Dictionaries API (word import)
OXFORD_API_KEY=
OXFORD_BASE_URL=https://www.oxfordlearnersdictionaries.com/api/v1

# Telegram bot that receives exception reports
TELEGRAM_BOT_TOKEN=

# Credentials for the user/auth microservice used by admin user tools
PYTHON_LOGIN=
PYTHON_PASSWORD=

DEBUGBAR_ENABLED=false
